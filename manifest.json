{
  "name": "Simply Said",
  "version": "0.1.0",
  "description": "A simple Chrome extension to show only spoken dialogues",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "Simply Said",
    "default_popup": "popup.html"
  },
  "manifest_version": 3
}
